---
import '../styles/global.css';

interface Props {
	title: string;
    description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description || "A minimalist blog about life, learning, and simplicity."} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
        <!-- Google Fonts - Nunito Sans (like zenhabits.net) + Crimson Pro + Cormorant Garamond -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,300;0,6..12,400;0,6..12,500;0,6..12,600;1,6..12,300;1,6..12,400&family=Crimson+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#fefefe] antialiased">
        <div class="max-w-[800px] mx-auto px-6 py-16 md:py-20">
            <!-- Header -->
            <header class="mb-16 flex flex-col md:flex-row md:items-baseline md:justify-between gap-4">
                <!-- Site Title -->
                <h1 class="site-title text-[2rem] md:text-[2.4rem] font-normal tracking-tight m-0">
                    <a href="/" class="hover:opacity-70 transition-opacity">sally kang</a>
                </h1>
                
                <!-- Navigation -->
                <nav>
                    <ul class="flex flex-wrap gap-x-8 list-none p-0 m-0 text-[1.25rem]">
                        <li><a href="/about" class="nav-link">about</a></li>
                        <li><a href="/archive" class="nav-link">archives</a></li>
                        <li><a href="/projects" class="nav-link">projects</a></li>
                    </ul>
                </nav>
            </header>

            <!-- Main Content -->
            <main>
		        <slot />
            </main>

            <!-- Footer -->
            <footer class="mt-24 pt-10 border-t border-[#e5e5e5] text-center">
                <div class="mb-6">
                    <ul class="flex flex-wrap justify-center gap-x-4 gap-y-2 list-none p-0 m-0 text-sm">
                        <li><a href="https://github.com/SallyKAN" target="_blank" class="footer-link">GitHub</a></li>
                        <li class="text-[#ddd]">•</li>
                        <li><a href="/archive" class="footer-link">Archives</a></li>
                    </ul>
                </div>
                <p class="text-sm text-[#999] font-light tracking-wide">
                    &copy; {new Date().getFullYear()} Sally Kang · <span class="text-[#c9a961]">Uncopyright</span>
                </p>
            </footer>
        </div>
	</body>
</html>

<style is:global>
    /* ========================================
       Zen Habits Inspired Typography
       ======================================== */
    
    :root {
        --font-sans: 'Nunito Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        --font-serif: 'Crimson Pro', Georgia, 'Times New Roman', serif;
        --font-display: 'Cormorant Garamond', Georgia, serif;
        --color-text: #333;
        --color-heading: #111;
        --color-muted: #888;
        --color-accent: #c9a961;
        --color-link: #333;
        --color-link-hover: #c9a961;
    }
    
    body {
        font-family: var(--font-sans);
        line-height: 1.5;
        font-size: 18px;
        font-weight: 300;
        color: var(--color-text);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }
    
    /* Site Title */
    .site-title {
        font-family: var(--font-display);
        font-weight: 500;
        letter-spacing: 0.02em;
    }
    .site-title a {
        color: var(--color-heading);
        text-decoration: none;
    }
    
    /* Tagline */
    .tagline a {
        font-family: var(--font-display);
        text-decoration: none;
    }
    
    /* Navigation */
    .nav-link {
        color: var(--color-muted);
        text-decoration: none;
        transition: color 0.2s ease;
        letter-spacing: 0.03em;
    }
    .nav-link:hover {
        color: var(--color-accent);
    }
    
    /* Footer Links */
    .footer-link {
        color: var(--color-muted);
        text-decoration: none;
        transition: color 0.2s ease;
    }
    .footer-link:hover {
        color: var(--color-accent);
    }
    
    /* Headings */
    h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-serif);
        font-weight: 600;
        color: var(--color-heading);
        line-height: 1.3;
    }
    
    h1 { 
        font-size: 2.2rem; 
        margin-top: 0;
        margin-bottom: 0.8em;
    }
    h2 { 
        font-size: 1.6rem; 
        margin-top: 2em;
        margin-bottom: 0.6em;
    }
    h3 { 
        font-size: 1.3rem; 
        margin-top: 1.8em;
        margin-bottom: 0.5em;
    }
    
    /* Paragraphs */
    p { 
        margin-bottom: 1.6em; 
        line-height: 1.75;
    }
    
    /* Links */
    a {
        color: var(--color-link);
        text-decoration: none;
        transition: color 0.2s ease;
    }
    a:hover {
        color: var(--color-link-hover);
    }
    
    /* Article Styles */
    article {
        max-width: 100%;
    }
    
    article h1 {
        font-size: 2.4rem;
        font-weight: 500;
        margin-bottom: 0.3em;
        line-height: 1.2;
    }
    
    article .meta {
        color: var(--color-muted);
        font-style: italic;
        font-size: 1rem;
        margin-bottom: 2.5em;
    }
    
    /* Prose content */
    .prose {
        max-width: none;
        color: var(--color-text);
        font-family: var(--font-sans);
        font-size: 18px;
        font-weight: 300;
        line-height: 1.5;
    }
    
    .prose h1, .prose h2, .prose h3 {
        color: var(--color-heading);
        font-family: var(--font-serif);
    }
    
    .prose h1 {
        font-size: 2.4rem;
        font-weight: 500;
    }
    
    .prose h2 {
        font-size: 1.6rem;
        font-weight: 600;
        margin-top: 2.5em;
        padding-bottom: 0.3em;
        border-bottom: 1px solid #eee;
    }
    
    .prose h3 {
        font-size: 1.35rem;
        font-weight: 600;
    }
    
    .prose p {
        font-size: 18px;
        line-height: 1.5;
        margin-bottom: 1.5em;
    }
    
    .prose a {
        color: var(--color-text);
        text-decoration: underline;
        text-decoration-color: var(--color-accent);
        text-underline-offset: 3px;
        transition: all 0.2s ease;
    }
    
    .prose a:hover {
        color: var(--color-accent);
    }
    
    .prose blockquote {
        border-left: 3px solid var(--color-accent);
        padding-left: 1.5em;
        margin: 2em 0;
        font-style: italic;
        color: #555;
    }
    
    .prose ul, .prose ol {
        margin-bottom: 1.5em;
        padding-left: 1.5em;
        font-size: 18px;
    }
    
    .prose li {
        margin-bottom: 0.5em;
        line-height: 1.5;
    }
    
    .prose code {
        background: #f5f5f5;
        padding: 0.2em 0.4em;
        border-radius: 3px;
        font-size: 0.9em;
    }
    
    .prose pre {
        background: #1a1a2e;
        color: #eee;
        padding: 1.5em;
        border-radius: 8px;
        overflow-x: auto;
        margin: 2em 0;
    }
    
    .prose pre code {
        background: none;
        padding: 0;
        color: inherit;
    }
    
    .prose img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        margin: 2em 0;
    }
    
    .prose hr {
        border: none;
        border-top: 1px solid #e5e5e5;
        margin: 3em 0;
    }
    
    /* Strong and emphasis */
    .prose strong {
        font-weight: 600;
        color: var(--color-heading);
    }
    
    .prose em {
        font-style: italic;
    }

    /* Selection */
    ::selection {
        background: rgba(201, 169, 97, 0.3);
    }
</style>
