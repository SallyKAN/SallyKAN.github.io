        max-width: 100%;
    }
    
    .page-title {
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-size: 2.2rem;
        font-weight: 400;
        color: #111;
        margin: 0 0 2rem 0;
        text-align: center;
    }
    
    .search-container {
        margin-bottom: 2.5rem;
    }
    
    .search-input {
        width: 100%;
        padding: 0.8rem 1rem;
        font-family: 'Nunito Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        font-size: 18px;
        font-weight: 300;
        color: #333;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 4px;
        outline: none;
        transition: border-color 0.2s ease;
    }
    
