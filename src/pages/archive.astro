---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => {
        const dateA = a.data.pubDate || new Date(0);
        const dateB = b.data.pubDate || new Date(0);
        return dateB.valueOf() - dateA.valueOf();
    }
);

// Group by Year -> Month
const archiveMap = posts.reduce((acc, post) => {
    const date = post.data.pubDate || new Date(0);
    const year = date.getFullYear();
    const month = date.toLocaleString('en-US', { month: 'long' });
    const monthNum = date.getMonth();

    if (!acc[year]) {
        acc[year] = {
            year,
            months: {}
        };
    }
    
    if (!acc[year].months[month]) {
        acc[year].months[month] = {
            name: month,
            order: monthNum,
            posts: []
        };
    }
    
    acc[year].months[month].posts.push(post);
    return acc;
}, {} as Record<number, { year: number, months: Record<string, { name: string, order: number, posts: typeof posts }> }>);

const years = Object.values(archiveMap).sort((a, b) => b.year - a.year);
---

<Layout title="Archives - Sally Kang">
    <div class="archive-page">
        <h2 class="page-title">Archives</h2>
        
        <!-- Search Box -->
        <div class="search-container">
            <input 
                type="text" 
                id="search-input" 
                class="search-input" 
                placeholder="Search posts..."
            />
        </div>
        
        <div class="archive-content" id="archive-content">
            {years.map(yearGroup => {
                const months = Object.values(yearGroup.months).sort((a, b) => b.order - a.order);
                return (
                    <section class="year-section" data-year={yearGroup.year}>
                        <h3 class="year-title">{yearGroup.year}</h3>
                        
                        {months.map(month => (
                            <div class="month-group" data-month={month.name}>
                                <h4 class="month-title">{month.name}</h4>
                                {month.posts.map(post => (
                                    <p class="post-item" data-title={post.data.title.toLowerCase()}>
                                        <span class="post-day">
                                            {post.data.pubDate ? post.data.pubDate.getDate().toString().padStart(2, '0') : ''}
                                        </span>
                                        <a href={`/blog/${post.slug}/`} class="post-link">
                                            {post.data.title}
                                        </a>
                                    </p>
                                ))}
                            </div>
                        ))}
                    </section>
                );
            })}
        </div>
        
        <div id="no-results" class="no-results" style="display: none;">
            No posts found.
        </div>
    </div>
</Layout>

<script>
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const archiveContent = document.getElementById('archive-content');
    const noResults = document.getElementById('no-results');
    
    searchInput?.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
        const postItems = document.querySelectorAll('.post-item');
        const monthGroups = document.querySelectorAll('.month-group');
        const yearSections = document.querySelectorAll('.year-section');
        
        let visibleCount = 0;
        
        postItems.forEach((item) => {
            const title = item.getAttribute('data-title') || '';
            const matches = query === '' || title.includes(query);
            (item as HTMLElement).style.display = matches ? '' : 'none';
            if (matches) visibleCount++;
        });
        
        // Hide empty month groups
        monthGroups.forEach((group) => {
            const visiblePosts = group.querySelectorAll('.post-item[style=""]').length + 
                                 group.querySelectorAll('.post-item:not([style])').length -
                                 group.querySelectorAll('.post-item[style="display: none;"]').length;
            const hasVisible = Array.from(group.querySelectorAll('.post-item')).some(
                (item) => (item as HTMLElement).style.display !== 'none'
            );
            (group as HTMLElement).style.display = hasVisible ? '' : 'none';
        });
        
        // Hide empty year sections
        yearSections.forEach((section) => {
            const hasVisible = Array.from(section.querySelectorAll('.month-group')).some(
                (group) => (group as HTMLElement).style.display !== 'none'
            );
            (section as HTMLElement).style.display = hasVisible ? '' : 'none';
        });
        
        // Show/hide no results message
        if (noResults) {
            noResults.style.display = visibleCount === 0 && query !== '' ? 'block' : 'none';
        }
    });
</script>

<style>
