        border-color: #c9a961;
    }
    
    .search-input::placeholder {
        color: #999;
    }
    
    .no-results {
        text-align: center;
        color: #888;
        font-family: 'Nunito Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        font-size: 18px;
        font-weight: 300;
        font-style: italic;
        padding: 2rem 0;
    }
    
    .year-section {
        margin-bottom: 1.5rem;
    }
    
    .year-title {
        font-family: 'Nunito Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        font-size: 22px;
        font-weight: 400;
        color: #111;
        margin: 0 0 0.8rem 0;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid #ddd;
    }
    
    .month-group {
        margin-bottom: 1rem;
        margin-left: 0;
    }
    
